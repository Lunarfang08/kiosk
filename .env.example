# Kiosk backend
ADMIN_TOKEN=change-me-admin-token
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_PATH=./avatar_data/kiosk.db
AVATAR_DATA_DIR=./avatar_data
MAX_UPLOAD_MB=25

# Dograh (server-side only — never expose to the browser)
DOGRAH_BASE_URL=https://api.dograh.com
DOGRAH_API_KEY=
DOGRAH_AGENT_ID=14591
DOGRAH_EMBED_TOKEN=

# LiveTalking (optional GPU profile)
LIVETALKING_BASE_URL=http://localhost:8010
LIVETALKING_ENABLED=false
AVATAR_ENGINE=portrait

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
